{
  "antigravity-cli-wakatime": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "scripts\\run.cmd --event=preInvocation || scripts/run --event=preInvocation 2>nul",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "scripts\\run.cmd --event=postToolUse || scripts/run --event=postToolUse 2>nul",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
